   "source": [
    "NON_ECONOMIC = ['RD', 'RAI', 'Talent', 'Policy', 'PublicOpinion', 'Infra']\n",
    "\n",
    "def ecosystem_score(scores):\n",
    "    return sum(scores[p] for p in NON_ECONOMIC) / len(NON_ECONOMIC)\n",
    "\n",
    "def hhi(scores):\n",
    "    values = [scores[p] for p in NON_ECONOMIC]\n",
    "    total = sum(values)\n",
    "    shares = [v / total for v in values]\n",
    "    return sum(s**2 for s in shares)\n",
    "\n",
    "countries = list(pillar_scores.keys())\n",
    "ecosystem = {c: ecosystem_score(pillar_scores[c]) for c in countries}\n",
    "concentration = {c: hhi(pillar_scores[c]) for c in countries}\n",
    "\n",
    "summary = pd.DataFrame({\n",
    "    'Ecosystem Score': ecosystem,\n",
    "    'HHI': concentration,\n",
    "    'Investment 2024 ($M)': investment_2024\n",
    "}).round(3)\n",
    "summary.sort_values('Investment 2024 ($M)', ascending=False)\n"
