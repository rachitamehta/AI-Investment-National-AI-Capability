    "trend_countries = ['United States', \"China (People's Republic of)\", 'United Kingdom', 'Canada', 'Germany', 'Israel']\n",
    "\n",
    "agg = df.groupby(['Year', 'Country_label'], as_index=False)['Sum_of_deals'].sum()\n",
    "pivot = agg[agg['Country_label'].isin(trend_countries)].pivot(\n",
    "    index='Year', columns='Country_label', values='Sum_of_deals').fillna(0)\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(10, 6))\n",
    "for c in trend_countries:\n",
    "    ax.plot(pivot.index, pivot[c], marker='o', label=c)\n",
    "\n",
    "ax.set_title('AI private investment by country, 2012–2026 (2026 partial year)')\n",
    "ax.set_xlabel('Year')\n",
    "ax.set_ylabel('AI private investment (USD millions)')\n",
    "ax.legend(loc='upper left', fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.savefig('fig1_investment_trend.png', dpi=150)\n",
    "plt.show()\n"
   ]
